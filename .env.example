# Copy this file to .env and fill in your own values.
# Never commit .env or paste secrets into frontend files.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1
AIVISION_ACCESS_PASSWORD=choose_a_long_unique_password
AIVISION_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
PORT=3000
NODE_ENV=development
